<Window x:Class="PhotoForge.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoForge Setup v1.0.0" Height="580" Width="760"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimary}"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="app.ico" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="PhotoForge Setup" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Offline-first Photo Metadata Continuity &amp; Format Conversion Platform" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content Body (Multi-step wizard) -->
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <!-- Step 1: Options -->
            <StackPanel x:Name="StepOptions" Visibility="Visible" VerticalAlignment="Center">
                <TextBlock Text="Installation Location:" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTargetDir" Grid.Column="0" Height="34" Padding="10,6" Background="{StaticResource CardBrush}" Foreground="White" BorderBrush="{StaticResource BorderBrush}" />
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Height="34" Click="BtnBrowse_Click" />
                </Grid>

                <TextBlock Text="Installation Options:" FontWeight="SemiBold" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkShortcuts" Content="Create Desktop and Start Menu shortcuts" IsChecked="True" Foreground="White" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkShell" Content="Enable Windows Explorer Context Menu integration" IsChecked="True" Foreground="White" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkPath" Content="Add PhotoForge CLI tool ('photoforge') to User PATH" IsChecked="True" Foreground="White" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkLaunch" Content="Launch PhotoForge Desktop after installation" IsChecked="True" Foreground="White" Margin="0,0,0,10" />
            </StackPanel>

            <!-- Step 2: Progress with Rotating Feature Slides -->
            <Grid x:Name="StepProgress" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Feature Slideshow Card -->
                <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,14">
                    <Grid>
                        <Image x:Name="ImgSlide" Stretch="UniformToFill" />
                        <Border Background="#88000000" VerticalAlignment="Bottom" Padding="14,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtSlideIndicator" Text="● ○ ○ ○" FontSize="14" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Progress and Status -->
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="TxtStatus" Text="Extracting application files..." FontSize="13" Margin="0,0,0,8" Foreground="{StaticResource TextSecondary}" />
                    <ProgressBar x:Name="PrgInstall" Height="14" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" />
                </StackPanel>
            </Grid>

            <!-- Step 3: Finished -->
            <StackPanel x:Name="StepFinished" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✔" FontSize="56" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="Installation Complete!" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="PhotoForge is ready for use on your machine." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,10,0" Click="BtnCancel_Click" />
                <Button x:Name="BtnInstall" Content="Install Now" Style="{StaticResource PrimaryButton}" Click="BtnInstall_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
