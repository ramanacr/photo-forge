<Window x:Class="PhotoForge.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoForge Setup v1.0.0" Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimary}"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="PhotoForge Setup" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Offline-first Photo Metadata Continuity &amp; Format Conversion Platform" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content Body (Multi-step wizard) -->
        <Grid Grid.Row="1" Margin="0,20,0,20">
            <!-- Step 1: Options -->
            <StackPanel x:Name="StepOptions" Visibility="Visible">
                <TextBlock Text="Installation Location:" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTargetDir" Grid.Column="0" Height="32" Padding="8,5" Background="{StaticResource CardBrush}" Foreground="White" BorderBrush="{StaticResource BorderBrush}" />
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Height="32" Click="BtnBrowse_Click" />
                </Grid>

                <TextBlock Text="Installation Options:" FontWeight="SemiBold" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkShortcuts" Content="Create Desktop and Start Menu shortcuts" IsChecked="True" Foreground="White" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkShell" Content="Enable Windows Explorer Context Menu integration" IsChecked="True" Foreground="White" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkPath" Content="Add PhotoForge CLI tool ('photoforge') to User PATH" IsChecked="True" Foreground="White" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkLaunch" Content="Launch PhotoForge Desktop after installation" IsChecked="True" Foreground="White" Margin="0,0,0,8" />
            </StackPanel>

            <!-- Step 2: Progress -->
            <StackPanel x:Name="StepProgress" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Extracting files..." FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Center" />
                <ProgressBar x:Name="PrgInstall" Height="16" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" />
            </StackPanel>

            <!-- Step 3: Finished -->
            <StackPanel x:Name="StepFinished" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✔ Installation Complete!" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="PhotoForge is ready for use on your machine." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,10,0" Click="BtnCancel_Click" />
                <Button x:Name="BtnInstall" Content="Install Now" Style="{StaticResource PrimaryButton}" Click="BtnInstall_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
