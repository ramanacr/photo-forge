<Application x:Class="PhotoForge.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#171A1C" />
        <SolidColorBrush x:Key="CardBrush" Color="#24292C" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#383F42" />
        <SolidColorBrush x:Key="AccentBrush" Color="#B7FF3C" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C9FF70" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F4EF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AAB2B0" />
        <SolidColorBrush x:Key="BorderBrush" Color="#485054" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#353B3E" />
        <SolidColorBrush x:Key="TextOnAccent" Color="#172000" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Resources>
</Application>
