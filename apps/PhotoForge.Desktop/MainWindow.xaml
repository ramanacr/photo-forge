<Window x:Class="PhotoForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoForge — Photo Metadata Continuity &amp; Format Platform"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDarker}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,24">
                    <TextBlock Text="PhotoForge" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" />
                    <TextBlock Text="Edit freely. Keep everything." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                    <Border Height="1" Background="{StaticResource SurfaceBorder}" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavHome" Content="🏠 Quick Restore" IsChecked="True" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                    <RadioButton x:Name="NavBatch" Content="⚡ Batch Processing" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                    <RadioButton x:Name="NavReview" Content="🔍 Match Review" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                    <RadioButton x:Name="NavDiff" Content="📊 Metadata Diff" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                    <RadioButton x:Name="NavHeic" Content="📦 HEIC Studio" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                    <RadioButton x:Name="NavHistory" Content="📜 Audit History" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                    <RadioButton x:Name="NavSettings" Content="⚙️ Settings" GroupName="Nav" Style="{x:Null}" Foreground="{StaticResource TextPrimary}" Padding="12,10" Margin="0,2" Cursor="Hand" Click="Nav_Click"/>
                </StackPanel>

                <!-- Status & Mode footer -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource SurfaceDark}" CornerRadius="6" Padding="10" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Local Offline Engine" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentSuccess}"/>
                            <TextBlock Text="100% On-Device · No Telemetry" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="24">
            <!-- 1. Quick Restore Tab -->
            <Grid x:Name="ViewHome" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Metadata Continuity" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Drop an edited photo to automatically discover its original and restore missing capture metadata." Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <!-- Drop Zones & Inputs -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Original Selection -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16" AllowDrop="True" Drop="Original_Drop" DragOver="DropZone_DragOver">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📷 Camera Original Photo" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Drag &amp; drop original camera photo here" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,12" />
                            <Button Content="Browse Original..." Click="BrowseOriginal_Click" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtOriginalPath" Text="(No file selected)" FontSize="11" Foreground="{StaticResource AccentPrimary}" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Edited Selection -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16" AllowDrop="True" Drop="Edited_Drop" DragOver="DropZone_DragOver">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎨 Edited Target Photo" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Drag &amp; drop edited copy or export here" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,12" />
                            <Button Content="Browse Edited..." Click="BrowseEdited_Click" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtEditedPath" Text="(No file selected)" FontSize="11" Foreground="{StaticResource AccentSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Controls -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkConvertToHeic" Content="Convert output to HEIC" Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkOverwrite" Content="In-place Overwrite" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Inspect Diff" Background="{StaticResource SurfaceDarker}" Margin="0,0,8,0" Click="InspectDiff_Click" />
                            <Button Content="⚡ Restore Metadata" Background="{StaticResource AccentSuccess}" Click="Restore_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 2. Batch Processing Tab -->
            <Grid x:Name="ViewBatch" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Batch Metadata Restoration" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

                <!-- Folders configuration -->
                <Grid Grid.Row="1" Margin="0,8,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Edited Photos Directory" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtBatchEditedDir" Margin="0,6,0,6" />
                            <Button Content="Choose Edited Folder..." Click="BrowseBatchEdited_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Originals Pool Directory" FontWeight="SemiBold" />
                            <TextBox x:Name="TxtBatchOriginalsDir" Margin="0,6,0,6" />
                            <Button Content="Choose Originals Folder..." Click="BrowseBatchOriginals_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Batch Results Table -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <ListView x:Name="ListBatchResults" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Edited Target" Width="200" DisplayMemberBinding="{Binding TargetFileName}" />
                                <GridViewColumn Header="Matched Original" Width="200" DisplayMemberBinding="{Binding OriginalFileName}" />
                                <GridViewColumn Header="Confidence" Width="100" DisplayMemberBinding="{Binding ScoreFormatted}" />
                                <GridViewColumn Header="Status" Width="140" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Notes" Width="240" DisplayMemberBinding="{Binding Notes}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Button Grid.Row="3" Content="Run Batch Migration" Background="{StaticResource AccentPrimary}" Margin="0,16,0,0" Click="RunBatch_Click" />
            </Grid>

            <!-- 3. Matching Review Tab -->
            <Grid x:Name="ViewReview" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Intelligent Match Review &amp; Override" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DataGrid x:Name="GridMatches" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="{StaticResource TextPrimary}" RowBackground="{StaticResource SurfaceDarker}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Target Image" Binding="{Binding TargetName}" Width="180" />
                            <DataGridTextColumn Header="Suggested Original" Binding="{Binding OriginalName}" Width="180" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidencePercent}" Width="90" />
                            <DataGridTextColumn Header="Decision Band" Binding="{Binding Band}" Width="130" />
                            <DataGridTextColumn Header="Match Reasons" Binding="{Binding ReasonsSummary}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Accept All High Confidence" Background="{StaticResource AccentSuccess}" Margin="0,0,8,0" Click="AcceptAllMatches_Click" />
                    <Button Content="Change Original..." Margin="0,0,8,0" Click="ChangeOriginal_Click" />
                    <Button Content="Mark No Original" Background="{StaticResource SurfaceDarker}" Click="MarkNoOriginal_Click" />
                </StackPanel>
            </Grid>

            <!-- 4. Metadata Diff Tab -->
            <Grid x:Name="ViewDiff" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Metadata Diff &amp; Merge Preview" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <TreeView x:Name="TreeMetadataDiff" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="13" />
                </Border>
            </Grid>

            <!-- 5. HEIC Studio Tab -->
            <Grid x:Name="ViewHeic" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="HEIC / WebP Conversion Studio" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Destination Format" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="ComboFormat" SelectedIndex="0" Margin="0,0,0,16" Padding="8">
                            <ComboBoxItem Content="HEIC (High Efficiency Image Container)" />
                            <ComboBoxItem Content="WebP (Modern Web Format)" />
                            <ComboBoxItem Content="PNG (Lossless Container)" />
                        </ComboBox>

                        <TextBlock Text="Compression Quality Preset" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="ComboQuality" SelectedIndex="1" Margin="0,0,0,16" Padding="8">
                            <ComboBoxItem Content="Lossless Where Supported" />
                            <ComboBoxItem Content="High Quality (Default — Q=85)" />
                            <ComboBoxItem Content="Very High Quality (Q=95)" />
                            <ComboBoxItem Content="Balanced Compression (Q=75)" />
                            <ComboBoxItem Content="Small File Size (Q=60)" />
                        </ComboBox>

                        <TextBlock Text="Metadata Handling Policy" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkPreserveAllXmp" Content="Preserve complete XMP and IPTC datasets" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkPreserveColorSpace" Content="Preserve ICC color profiles" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                    </StackPanel>
                </Border>
                <Button Grid.Row="2" Content="Convert Selected Photos" Background="{StaticResource AccentPrimary}" Margin="0,16,0,0" Click="ConvertStudio_Click" />
            </Grid>

            <!-- 6. History Tab -->
            <Grid x:Name="ViewHistory" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Local SQLite Audit History" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="{StaticResource TextPrimary}" RowBackground="{StaticResource SurfaceDarker}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Target File" Binding="{Binding TargetRef.FileName}" Width="200" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                            <DataGridTextColumn Header="Completed At (UTC)" Binding="{Binding CompletedAtUtc}" Width="180" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding OutputPath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Refresh History" Margin="0,0,8,0" Click="RefreshHistory_Click" />
                    <Button Content="Export Report (Markdown / JSON)..." Background="{StaticResource AccentSecondary}" Click="ExportReport_Click" />
                </StackPanel>
            </Grid>

            <!-- 7. Settings Tab -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Settings &amp; System Integration" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Default GPS Privacy Policy" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox x:Name="ComboGpsPolicy" SelectedIndex="0" Margin="0,0,0,16" Padding="8">
                            <ComboBoxItem Content="Keep Exact Coordinates (Full Precision)" />
                            <ComboBoxItem Content="Remove GPS Data Completely" />
                            <ComboBoxItem Content="Round Coordinates (~1km privacy buffer)" />
                            <ComboBoxItem Content="Copy with Privacy Warning" />
                        </ComboBox>

                        <TextBlock Text="Windows Explorer Integration" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkExplorerMenu" Content="Add PhotoForge to Windows Explorer context menu" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" Checked="ExplorerMenu_Checked" Unchecked="ExplorerMenu_Unchecked" />

                        <TextBlock Text="Software Updates" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Border Background="{StaticResource SurfaceDarker}" CornerRadius="6" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtVersionInfo" Text="PhotoForge v1.0.0 (Latest Release)" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtUpdateStatus" Text="Self-updating directly from GitHub Releases" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnCheckUpdates" Content="🔄 Check for Updates" Padding="12,6" Click="CheckUpdates_Click" />
                                    <ProgressBar x:Name="PrgUpdate" Width="150" Height="14" Margin="12,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Privacy Guarantee" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="PhotoForge operates 100% locally on your device. Original files are never modified. No telemetry, analytical beacons, or remote cloud connections are established." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
